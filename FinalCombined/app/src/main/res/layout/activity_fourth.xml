<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/foodbackground"
    tools:context=".FourthActivity">

    <TextView
        android:id="@+id/activity1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="50dp"
        android:gravity="center"
        android:text="Welcome to Van and Hyla's Food Stuff"
        android:textColor="@color/white"
        android:textSize="35sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTakeOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/activity1"
        android:layout_centerHorizontal="true"
        android:layout_margin="20dp"
        android:text="Take Out"
        android:textSize="30sp"
        android:backgroundTint="#fcdc0b" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDineIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnTakeOut"
        android:layout_centerHorizontal="true"
        android:layout_margin="20dp"
        android:text="Dine In"
        android:textSize="32sp"
        android:backgroundTint="#fcdc0b" />

</RelativeLayout>
